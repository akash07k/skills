diff --git a/src/zones/lookup.ts b/src/zones/lookup.ts
new file mode 100644
--- /dev/null
+++ b/src/zones/lookup.ts
@@ -0,0 +1,56 @@
+import { RATES_00 } from './zone-00';
+import { RATES_01 } from './zone-01';
+import { RATES_02 } from './zone-02';
+import { RATES_03 } from './zone-03';
+import { RATES_04 } from './zone-04';
+import { RATES_05 } from './zone-05';
+import { RATES_06 } from './zone-06';
+import { RATES_07 } from './zone-07';
+import { RATES_08 } from './zone-08';
+import { RATES_09 } from './zone-09';
+import { RATES_10 } from './zone-10';
+import { RATES_11 } from './zone-11';
+import { RATES_12 } from './zone-12';
+import { RATES_13 } from './zone-13';
+import { RATES_14 } from './zone-14';
+import { RATES_15 } from './zone-15';
+import { RATES_16 } from './zone-16';
+import { RATES_17 } from './zone-17';
+import { RATES_18 } from './zone-18';
+import { RATES_19 } from './zone-19';
+
+const tables = [
+  RATES_00,
+  RATES_01,
+  RATES_02,
+  RATES_03,
+  RATES_04,
+  RATES_05,
+  RATES_06,
+  RATES_07,
+  RATES_08,
+  RATES_09,
+  RATES_10,
+  RATES_11,
+  RATES_12,
+  RATES_13,
+  RATES_14,
+  RATES_15,
+  RATES_16,
+  RATES_17,
+  RATES_18,
+  RATES_19,
+];
+
+export interface RateSource { get(zoneId: string): number; }
+
+export class TableRateSource implements RateSource {
+  get(zoneId: string): number {
+    const rates: Record<string, number> = Object.assign({}, ...tables);
+    return rates[zoneId] ?? 0;
+  }
+}
+
+export function lookupRate(zoneId: string): number {
+  return new TableRateSource().get(zoneId);
+}
